<idea-plugin>
    <id>com.rixit.claude.chat</id>
    <name>Claude Chat</name>
    <vendor email="info@rixitsolutions.be" url="https://rixitsolutions.be">Rix IT Solutions</vendor>

    <description><![CDATA[
        Chat with Claude from inside Rider.
        <ul>
            <li>Tool window with conversation history</li>
            <li>Send the current file or selection as context</li>
            <li>Cursor position and file path are auto-attached</li>
            <li>Model and API key configured in Settings &rarr; Tools &rarr; Claude Chat</li>
        </ul>
    ]]></description>

    <change-notes><![CDATA[
        <h3>0.1.0</h3>
        <ul><li>Initial release: chat tool window, file/selection attach, configurable model.</li></ul>
    ]]></change-notes>

    <!-- Works in any JetBrains IDE built on the platform (Rider included). -->
    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="ClaudeChat"
                    anchor="right"
                    factoryClass="com.rixit.claude.ui.ClaudeChatToolWindowFactory"
                    icon="AllIcons.Toolwindows.ToolWindowMessages"/>

        <applicationConfigurable parentId="tools"
                                 instance="com.rixit.claude.settings.ClaudeSettingsConfigurable"
                                 id="com.rixit.claude.settings"
                                 displayName="Claude Chat"/>

        <applicationService serviceImplementation="com.rixit.claude.settings.ClaudeSettings"/>
    </extensions>

    <actions>
        <action id="Claude.OpenChat"
                class="com.rixit.claude.actions.OpenChatAction"
                text="Open Claude Chat"
                description="Focus the Claude chat tool window">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt K"/>
        </action>

        <action id="Claude.SendCurrentFile"
                class="com.rixit.claude.actions.SendCurrentFileAction"
                text="Send Current File to Claude"
                description="Attach the active file to your next Claude message">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="ToolsMenu" anchor="after" relative-to-action="Claude.OpenChat"/>
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt shift F"/>
        </action>

        <action id="Claude.SendSelection"
                class="com.rixit.claude.actions.SendSelectionAction"
                text="Send Selection to Claude"
                description="Attach the current selection to your next Claude message">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="ToolsMenu" anchor="after" relative-to-action="Claude.SendCurrentFile"/>
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt shift S"/>
        </action>
    </actions>
</idea-plugin>
